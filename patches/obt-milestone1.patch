diff --git a/localisation/english/MD_focus_TAI_l_english.yml b/localisation/english/MD_focus_TAI_l_english.yml
index 5fafa3ef96..69e0c0755e 100644
--- a/localisation/english/MD_focus_TAI_l_english.yml
